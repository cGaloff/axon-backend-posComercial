# Plantilla de configuración de PRODUCCIÓN.
# En el VPS: copia a .env  ->  cp .env.prod.example .env  ->  y rellena valores reales.
# El archivo .env NUNCA se sube al repo (está en .gitignore).

# --- PostgreSQL ---
POSTGRES_USER=axon_user
POSTGRES_PASSWORD=CAMBIA-esto-por-una-clave-fuerte
POSTGRES_DB=axon_master

# --- JWT ---
# Genera la clave con:  openssl rand -base64 48   (mínimo 32 caracteres)
JWT_KEY=CAMBIA-esto-clave-aleatoria-de-al-menos-32-caracteres
JWT_ISSUER=axon-api
JWT_AUDIENCE=axon-client
JWT_EXPIRES_MINUTES=60
JWT_REFRESH_DAYS=7

# --- Webhooks ---
# Genera con:  openssl rand -base64 24
WEBHOOK_PAYMENT_SECRET=CAMBIA-esto-secreto-webhook

# --- CORS ---
# Dominios EXACTOS de tu frontend, separados por coma (sin barra final).
# Ej: https://app.midominio.com,https://admin.midominio.com
CORS_ALLOWED_ORIGINS=https://app.tudominio.com

# --- Email (SMTP) ---
EMAIL_SMTP_HOST=smtp.tudominio.com
EMAIL_SMTP_PORT=587
EMAIL_FROM_ADDRESS=noreply@tudominio.com
EMAIL_FROM_NAME=AxonPOS
EMAIL_USERNAME=
EMAIL_PASSWORD=

# --- Recuperación de contraseña ---
# Pantalla del frontend que procesa el link del email (lee ?token=...&tenant=...
# de la URL y llama POST /api/auth/reset-password). Sin barra final.
FRONTEND_RESET_PASSWORD_URL=https://app.tudominio.com/reset-password
# Minutos de validez del link de recuperación antes de expirar.
PASSWORD_RESET_TOKEN_MINUTES=30

# --- Verificación de email en el registro ---
# Minutos de validez del código de 6 dígitos que confirma el correo antes de
# crear el tenant (POST /api/tenants/register/confirm).
REGISTRATION_CODE_MINUTES=15

# --- Suscripciones / vencimiento de prueba gratuita ---
# Días de prueba gratuita desde el registro.
SUBSCRIPTION_TRIAL_DAYS=7
# A cuántos días de vencer empieza a mandar el recordatorio diario por email.
SUBSCRIPTION_REMINDER_DAYS=5
# Cada cuántos minutos corre el barrido que bloquea tenants vencidos y manda
# los recordatorios.
SUBSCRIPTION_CHECK_INTERVAL_MINUTES=60
# Protege POST /api/subscription/extend (reactiva/extiende un tenant a mano
# mientras no hay pasarela de pagos integrada). Genera con:
# openssl rand -base64 24
SUBSCRIPTION_EXTENSION_SECRET=CAMBIA-esto-secreto-suscripcion
